{
  "name": "Avatar card",
  "source": "An avatar card: background, avatar, name, handle, quote",
  "canvas": {
    "width": 1080,
    "height": 1080,
    "background": "color:1e293b"
  },
  "slots": [
    {
      "name": "avatar",
      "kind": "image",
      "image": "{{avatar}}",
      "x": "center",
      "y": "180",
      "width": "280",
      "height": "280"
    },
    {
      "name": "name",
      "kind": "text",
      "text": "{{name}}",
      "x": "center",
      "y": "540",
      "font": "sans-bold-52",
      "color": "ffffff"
    },
    {
      "name": "role",
      "kind": "text",
      "text": "{{role}}",
      "x": "80",
      "y": "610",
      "width": "full-160",
      "height": "44",
      "font": "sans",
      "color": "cbd5e1",
      "align": "low",
      "max_size": 36,
      "min_size": 20
    },
    {
      "name": "handle",
      "kind": "text",
      "text": "{{handle}}",
      "x": "80",
      "y": "full-120",
      "font": "sans-26",
      "color": "3b82f6"
    }
  ],
  "values": {
    "name": "Mei Lam",
    "role": "Platform engineering",
    "handle": "@meilam",
    "quote": "The same bytes in, the same bytes out.",
    "avatar": "http://localhost:8198/src_p1.png"
  }
}
