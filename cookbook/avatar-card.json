{
  "name": "Mei Lam portrait profile card",
  "note": "A balanced 4:5 profile card with a smart-cropped circular portrait and a centered identity block.",
  "canvas": {
    "width": 1080,
    "height": 1350,
    "background": "color:173f34"
  },
  "slots": [
    {
      "name": "cream inset border",
      "kind": "rect",
      "image": "color:f4f1e8",
      "x": "2p+10",
      "y": "2p+5",
      "width": "full-64",
      "height": "full-64"
    },
    {
      "name": "green card panel",
      "kind": "rect",
      "image": "color:173f34",
      "x": "4p+5",
      "y": "3p+8",
      "width": "full-96",
      "height": "full-96"
    },
    {
      "name": "circular portrait",
      "kind": "image",
      "image": "http://localhost:8198/src_life.png",
      "filters": "smart/filters:round_corner(200,200,173f34)",
      "x": "31p+5",
      "y": "25p+12",
      "width": "37p",
      "height": "29p+8"
    },
    {
      "name": "centered profile text block",
      "kind": "image",
      "x": "0p",
      "y": "58p+7",
