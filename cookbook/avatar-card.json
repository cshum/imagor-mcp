        },
        {
          "name": "role",
          "kind": "text",
          "text": "{{role}}",
          "x": "center",
          "y": "35p+2",
          "font": "Open-Sans",
          "size": 34,
          "color": "cbd4ce"
        },
        {
          "name": "handle",
          "kind": "text",
          "text": "{{handle}}",
          "x": "center",
          "y": "62p",
          "font": "Open-Sans",
          "size": 29,
          "color": "d8c79b"
        }
      ]
    }
  ],
  "values": {
    "name": "Mei Lam",
    "role": "Platform engineering",
    "handle": "@meilam"
