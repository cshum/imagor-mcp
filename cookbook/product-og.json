{
  "name": "Product OG image",
  "source": "A product share card: title, price, collection, featured image, logo",
  "canvas": {
    "width": 1200,
    "height": 630,
    "background": "color:ffffff"
  },
  "slots": [
    {
      "name": "shot",
      "kind": "image",
      "image": "{{featured_image}}",
      "x": "half",
      "y": "0",
      "width": "half",
      "height": "full"
    },
    {
      "name": "collection",
      "kind": "text",
      "text": "{{collection}}",
      "x": "60",
      "y": "180",
      "font": "sans-bold-20",
      "color": "64748b"
    },
    {
      "name": "title",
      "kind": "text",
      "text": "{{title}}",
      "x": "60",
      "y": "230",
      "width": "half-120",
      "height": "150",
      "font": "sans",
      "color": "0f172a",
      "max_size": 52,
      "min_size": 24,
      "align": "low"
    },
    {
      "name": "price",
      "kind": "text",
      "text": "{{price}}",
      "x": "60",
      "y": "full-200",
      "font": "sans-bold-44",
      "color": "111827"
    },
    {
      "name": "cta",
      "kind": "text",
      "text": "{{cta}}",
      "x": "60",
      "y": "full-140",
      "font": "sans-22",
      "color": "2563eb"
    },
    {
      "name": "logo",
      "kind": "image",
      "image": "{{logo}}",
      "x": "60",
      "y": "80",
      "width": "120"
    }
  ],
  "values": {
    "name": "Intrecciato 19 shoulder bag",
    "price": "HKD$18500",
    "collection": "Autumn 2026",
    "cta": "Free delivery",
    "featured_image": "http://localhost:8198/src_p1.png",
    "logo": "http://localhost:8198/src_p1.png",
    "title": "Intrecciato 19 shoulder bag"
  }
}
