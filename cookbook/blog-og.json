{
  "name": "Blog OG image",
  "source": "A blog share card: title, author, date, author photo, cover",
  "canvas": {
    "width": 1200,
    "height": 630,
    "background": "color:0f172a"
  },
  "slots": [
    {
      "name": "cover",
      "kind": "image",
      "image": "{{cover}}",
      "x": "half",
      "y": "0",
      "width": "half",
      "height": "full"
    },
    {
      "name": "eyebrow",
      "kind": "text",
      "text": "{{date}}",
      "x": "60",
      "y": "70",
      "font": "sans-bold-20",
      "color": "3b82f6"
    },
    {
      "name": "title",
      "kind": "text",
      "text": "{{title}}",
      "x": "60",
      "y": "130",
      "width": "half-120",
      "height": "300",
      "font": "serif",
      "color": "ffffff",
      "max_size": 72,
      "min_size": 26
    },
    {
      "name": "avatar",
      "kind": "image",
      "image": "{{author_photo}}",
      "x": "60",
      "y": "full-140",
      "width": "72",
      "height": "72"
    },
    {
      "name": "author",
      "kind": "text",
      "text": "{{author}}",
      "x": "150",
      "y": "full-116",
      "font": "sans-24",
      "color": "94a3b8"
    }
  ],
  "values": {
    "title": "A filter that does nothing returns 200",
    "date": "October 2026",
    "author": "imagor",
    "subtitle": "Why verification had to become part of the tool",
    "author_photo": "http://localhost:8198/src_p1.png",
    "cover": "http://localhost:8198/src_life.png"
  }
}
